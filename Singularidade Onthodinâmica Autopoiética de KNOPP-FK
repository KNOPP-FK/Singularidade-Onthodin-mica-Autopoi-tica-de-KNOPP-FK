import numpy as np
import matplotlib.pyplot as plt

# --- ESTÉTICA DE ARQUIVAMENTO ---
plt.style.use('dark_background')
GOLDEN_NEON = "#FFD700" # Ouro para a Constante Universal
BG_FINAL = "#000000"

# Gerando a "Assinatura de Imunidade"
t = np.linspace(0, 2*np.pi, 1000)
# A forma geométrica que representa a estabilidade absoluta de C
x = (1 + 0.1 * np.cos(100 * t)) * np.cos(t)
y = (1 + 0.1 * np.cos(100 * t)) * np.sin(t)

fig, ax = plt.subplots(figsize=(8, 8), facecolor=BG_FINAL)
ax.set_facecolor(BG_FINAL)

# Plotando a geometria da imunidade
ax.plot(x, y, color=GOLDEN_NEON, linewidth=0.5, alpha=0.8)
ax.fill(x, y, color=GOLDEN_NEON, alpha=0.1)

ax.set_title("ASSINATURA DE SISTEMA INVARIANTE: NÚCLEO C de KNOPP", color=GOLDEN_NEON, pad=20)
ax.axis('off')

plt.show()

